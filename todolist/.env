# .env

# MySQL Database Configuration
DB_HOST=127.0.0.1       # หรือ 'db' ถ้าใช้งานใน Docker Compose
DB_PORT=3306            # พอร์ตของ MySQL (ปกติจะใช้ 3306)
DB_USER=root            # ชื่อผู้ใช้งาน MySQL
DB_PASSWORD=rootpassword  # รหัสผ่าน MySQL
DB_NAME=todos           # ชื่อฐานข้อมูลที่ใช้

# พอร์ตของ API ที่จะฟัง
PORT=5000